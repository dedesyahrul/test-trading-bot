# Production Environment Variables
# Copy to .env and update values for your environment

# Application
ENVIRONMENT=production
DEBUG=false
APP_NAME=MemeX
APP_VERSION=0.1.0

# Database
DB_USER=memex
DB_PASSWORD=change_this_secure_password
DB_NAME=memex
DB_HOST=postgres
# DATABASE_URL internal Docker (hostname postgres, port container 5432)
DATABASE_URL=postgresql://memex:change_this_secure_password@postgres:5432/memex

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Trading
TRADING_MODE=PAPER
INITIAL_BALANCE=10000

# API
API_PREFIX=/api
DEX_SCREENER_API_URL=https://api.dexscreener.com/latest/dex

# Ports (host → container)
BACKEND_PORT=17845
FRONTEND_PORT=13456
DB_PORT=15487
REDIS_PORT=16721

# Frontend
# Empty values make the frontend use the same-origin Nginx proxy.
VITE_API_URL=
VITE_WS_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/memex/app.log

# CORS
CORS_ORIGINS=["http://localhost:13456", "http://localhost"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Security Headers
ENABLE_SECURITY_HEADERS=true
ENABLE_HTTPS_REDIRECT=false

# Monitoring & Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
