# Environment variables for MemeX

# App
DEBUG=false
APP_ENV=development

# Database
DATABASE_URL=postgresql://memex:memex@localhost:5432/memex

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production

# Trading
TRADING_MODE=PAPER

# API
DEX_SCREENER_API_URL=https://api.dexscreener.com/latest/dex

# Wallet (DO NOT commit real private keys!)
# WALLET_PRIVATE_KEY=your_encrypted_private_key_here
