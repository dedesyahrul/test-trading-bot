# Environment variables for MemeX

# App
DEBUG=false
APP_ENV=development
ENVIRONMENT=development

# Host Ports (mapped to container — see docs/docker-guide.md#5-port-registry)
FRONTEND_PORT=13456
BACKEND_PORT=17845
DB_PORT=15487
REDIS_PORT=16721

# Database (host access — use DB_PORT for localhost connections)
DB_USER=memex
DB_PASSWORD=memex
DB_NAME=memex
DATABASE_URL=postgresql://memex:memex@localhost:15487/memex

# Redis (host access)
REDIS_URL=redis://localhost:16721/0

# Security
SECRET_KEY=your-secret-key-change-in-production

# Trading
TRADING_MODE=PAPER
AUTO_CREATE_TABLES=false

# Observability (optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Blockchain / Jupiter (LIVE trading)
JUPITER_API_URL=https://quote-api.jup.ag/v6
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DEFAULT_SLIPPAGE_BPS=50
MAX_LIVE_TRADE_USD=100
# WALLET_PRIVATE_KEY=base58-encoded-private-key

# ML
ML_PREDICTION_THRESHOLD=0.65

# API
DEX_SCREENER_API_URL=https://api.dexscreener.com/latest/dex

# Frontend URLs (host access)
VITE_API_URL=http://localhost:17845/api
VITE_WS_URL=ws://localhost:17845/ws

# Wallet (DO NOT commit real private keys!)
# WALLET_PRIVATE_KEY=your_encrypted_private_key_here
